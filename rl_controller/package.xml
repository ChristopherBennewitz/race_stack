<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rl_controller</name>
  <version>0.0.0</version>
  <description>Deploys a PPO/RMA policy trained in f1tenth_parallel_sim as a drive controller</description>
  <maintainer email="christopher.bennewitz@gmx.de">chris</maintainer>
  <license>MIT</license>

  <test_depend>python3-pytest</test_depend>

  <exec_depend>ros2launch</exec_depend>
  <depend>rclpy</depend>
  <depend>ackermann_msgs</depend>
  <depend>f110_msgs</depend>
  <depend>nav_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
